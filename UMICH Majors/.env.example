# Google AI Studio (Gemini) — OpenAI-compatible endpoint.
# Get a key at https://aistudio.google.com/apikey
# This project does NOT use Tokenplex / Akaike keys — keep those out of this folder.

UMICH_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
UMICH_LLM_API_KEY=
UMICH_LLM_MODEL=gemini-flash-latest

# Other options (if your project has quota): gemini-2.0-flash, gemini-2.0-flash-lite
