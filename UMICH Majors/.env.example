# Google AI Studio (Gemini) — OpenAI-compatible endpoint.
# Get a key at https://aistudio.google.com/apikey
# This project does NOT use Tokenplex / Akaike keys — keep those out of this folder.

UMICH_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
UMICH_LLM_API_KEY=
UMICH_LLM_MODEL=gemini-flash-lite-latest

# Rotate on 429. Prefer lite/2.0-flash for JSON extract; flash-latest thinks
# and often truncates. (gemini-2.5-flash* is unavailable to new API keys.)
# UMICH_LLM_MODELS=gemini-flash-lite-latest,gemini-2.0-flash,gemini-flash-latest
# UMICH_LLM_PACING_SEC=1.5
