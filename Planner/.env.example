# UMich Schedule of Classes (SOC) API — from https://developer.umich.edu/
UMICH_SOC_CLIENT_ID=
UMICH_SOC_CLIENT_SECRET=

# Supabase (personalized guide) — Project Settings → API
# Use the anon/public key only in the frontend — never the service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Transcript PDF parser (production). Leave empty for local dev (Vite proxy).
# Example: https://umich-transcript-api.onrender.com
VITE_TRANSCRIPT_API_URL=
